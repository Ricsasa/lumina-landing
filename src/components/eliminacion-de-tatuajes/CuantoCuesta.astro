---
import PricingCalculator from "./PricingCalculator.jsx";

import ManosDark from "../../assets/services/tattoos/manos_dark.avif";
import ManosLight from "../../assets/services/tattoos/manos_light.avif";
import { Image } from "astro:assets";
import SectionHeading from "../common/SectionHeading.astro";
---

<section
    class="flex flex-col items-center px-4 md:px-6 scroll-mt-36 md:scroll-mt-40 py-20 w-full"
    id="costos"
>
    <!-- Section Header -->
    <SectionHeading title="¿Cuánto cuesta?"
        subtitle="Conoce nuestros precios y paquetes."
    />

    <!-- Pricing Tool -->
    <PricingCalculator astroUrl={Astro.url.href} client:load />

    <div class="gsap-reveal-card mx-auto max-w-3xl text-center">
        <p
            class="my-4 text-base md:text-lg text-custom-oscuro/70 dark:text-custom-piel font-light px-4"
        >
            ¿No sabes cuanto mide tu tatuaje? Usa esta guia visual para estimar
            su tamaño.
        </p>
        <div
            class="flex items-start gap-4 p-6 shadow-sm hover:shadow-md border border-custom-piel/10 dark:border-custom-beige/20 hover:border-custom-piel/20 dark:hover:border-custom-beige/40 transition-all duration-300 rounded-3xl mb-8"
        >
            <Image
                src={ManosDark}
                alt="Guia visual de tamaños de tatuajes"
                class="hidden dark:block"
                format="avif"
                title="Guia visual de tamaños de tatuajes"
            />
            <Image
                src={ManosLight}
                alt="Guia visual de tamaños de tatuajes"
                class="block dark:hidden"
                format="avif"
                title="Guia visual de tamaños de tatuajes"
            />
        </div>
    </div>
</section>
